<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(AppTargetFramework)</TargetFramework>

    <PackAsTool>true</PackAsTool>
    <ToolCommandName>keyVaulter</ToolCommandName>
    <Description>Run this tool at your solution root to fix projects relative directories.</Description>

    <UserSecretsId>tools</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="5.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.AzureKeyVault" Version="3.1.13" />
  </ItemGroup>
</Project>
